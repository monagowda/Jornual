datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Entry {
  id        String   @id @default(uuid())
  date      String   @unique
  title     String   @default("")
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Preference {
  key   String @id
  value String
}
